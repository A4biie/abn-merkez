{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ABN Launcher",
  "version": "1.4.0",
  "identifier": "com.abn.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ABN Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "decorations": false
      },
      {
        "label": "splash",
        "title": "ABN Launcher",
        "url": "splash.html",
        "create": false,
        "width": 340,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Abby's Nexus",
    "category": "Productivity",
    "shortDescription": "ABN Merkez ve ABN oyunları",
    "longDescription": "Abby's Nexus ekibinin masaüstü uygulaması: ABN Merkez'i açar, ABN oyunlarını kurar, günceller ve başlatır.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Turkish"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/installer.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczMEU3MTlFNTUwRkVBNzQKUldSMDZnOVZubkVPY3dGWW5VMG10b0MzQXM5dmJxbkU4M3hseFc5UmZWNzFVQ3NZOVIxVm41Q1QK",
      "endpoints": [
        "https://github.com/__GITHUB_REPO__/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "abn"
        ]
      }
    }
  }
}
