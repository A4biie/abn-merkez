{
  "identifier": "default",
  "description": "Launcher, açılış, Merkez ve hızlı fikir pencereleri.",
  "windows": [
    "main",
    "splash",
    "merkez",
    "fikir"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:default",
    "autostart:default",
    "dialog:default",
    "deep-link:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
